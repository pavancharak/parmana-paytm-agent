# Agent API
AGENT_API_KEY=

# Parmana
PARMANA_API_URL=https://parmana-api-real.vercel.app
PARMANA_API_KEY=
PARMANA_PRINCIPAL_ID=demo

# Parmana -> Paytm remote connector trust boundary
PAYTM_CONNECTOR_SHARED_SECRET=

# Execution-audit trail (GAP-3). Direct Postgres connection string to the
# SAME database AgentLabsBuildathon's own DATABASE_URL points at -- this
# service writes into that repo's execution_audit_events table (see
# src/parmana/audit.ts), not a separate table, so a query by
# businessTransactionId retrieves one refund's complete story across both
# services. Required -- this service refuses to start without it (GAP-3
# fails closed the same way every other required setting here does).
DATABASE_URL=

# Paytm: use staging first. Never commit credentials.
PAYTM_ENVIRONMENT=staging
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=

# Runtime
PORT=3000
REQUEST_TIMEOUT_MS=10000
